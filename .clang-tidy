# Start strict-but-practical; tighten (e.g. WarningsAsErrors) once the code base settles.
Checks: >
  -*,
  bugprone-*,
  -bugprone-easily-swappable-parameters,
  clang-analyzer-*,
  cppcoreguidelines-*,
  -cppcoreguidelines-avoid-magic-numbers,
  -cppcoreguidelines-pro-bounds-pointer-arithmetic,
  -cppcoreguidelines-avoid-non-const-global-variables,
  misc-*,
  -misc-non-private-member-variables-in-classes,
  modernize-*,
  -modernize-use-trailing-return-type,
  -modernize-use-nodiscard,
  performance-*,
  readability-*,
  -readability-magic-numbers,
  -readability-identifier-length
WarningsAsErrors: ''
HeaderFilterRegex: '^.*/(trace|policy|sim|sketch|ml|server|apps)/.*'
FormatStyle: file
CheckOptions:
  # Allow single-line `if (x) return;` (Google style); multi-line bodies still need braces.
  - key: readability-braces-around-statements.ShortStatementLines
    value: 2
  # GoogleTest's EXPECT_*/ASSERT_* macros expand into branches that inflate complexity.
  - key: readability-function-cognitive-complexity.IgnoreMacros
    value: true
